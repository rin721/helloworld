{
  "name": "hello-world-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "content:check": "tsx scripts/check-content.ts",
    "test": "vitest run",
    "build": "pnpm content:check && astro build && pagefind --site dist && tsx scripts/check-output.ts",
    "preview": "astro preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "astro": "7.3.3",
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "cheerio": "^1.0.0",
    "gray-matter": "^4.0.3",
    "pagefind": "latest",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vitest": "latest"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "sharp"] }
}
