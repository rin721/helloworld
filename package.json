{
  "name": "hello-world-journal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "pnpm content:check && astro build && pagefind --site dist && tsx scripts/check-output.ts",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "content:check": "tsx scripts/check-content.ts",
    "new-post": "node scripts/new-post.js",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@expressive-code/core": "^0.44.2",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify/svelte": "^5.2.2",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.2.0",
    "hastscript": "^9.0.1",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.16.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^1.0.0",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "stylus": "^0.64.0",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.12",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/sanitize-html": "^2.16.1",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
