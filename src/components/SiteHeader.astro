---
/** 站点页头：词标、主导航、语言切换、外观与配色设置、移动端菜单入口。 */
import { site, labels, type Locale } from '../config';
import IconButton from './ui/IconButton.astro';
import SegmentedControl from './ui/SegmentedControl.astro';
import PaletteSwatches from './ui/PaletteSwatches.astro';
import Popover from './ui/Popover.astro';
import Icon from './ui/Icon.astro';
import { paletteNames } from '../lib/palettes';
interface Props { locale: Locale; path: string; alternate: string | null }
const { locale, path, alternate } = Astro.props;
const t = labels[locale];
const other = locale === 'zh' ? 'en' : 'zh';
const links = [
  { href: `/${locale}/#journal`, label: t.journal, active: path === `/${locale}/` },
  { href: `/${locale}/archive/`, label: t.archive, active: path.includes('/archive/') },
  { href: `/${locale}/about/`, label: t.about, active: path.includes('/about/') },
];
const theme = [
  { value: 'system', label: t.system, icon: 'monitor' as const },
  { value: 'light', label: t.light, icon: 'sun' as const },
  { value: 'dark', label: t.dark, icon: 'moon' as const },
];
/* 配色名称沿用界面词典的表述习惯：中文直接命名颜色，英文用对应的色名。 */
const paletteLabels: Record<string, string> = locale === 'zh'
  ? { slate: '蓝灰', jade: '青绿', violet: '紫罗兰', clay: '暖橙', graphite: '石墨' }
  : { slate: 'Slate', jade: 'Jade', violet: 'Violet', clay: 'Clay', graphite: 'Graphite' };
const palettes = paletteNames.map(value => ({ value, label: paletteLabels[value] ?? value }));
const languageLink = alternate
  ? { href: alternate, label: other === 'en' ? 'EN' : '中文', aria: other === 'en' ? 'Switch to English' : '切换到中文' }
  : { href: null, label: other === 'en' ? 'EN' : '中文', aria: other === 'en' ? 'English translation unavailable' : '暂无中文译文' };
---
<header
  class="site-header group sticky top-0 z-30 bg-glass backdrop-blur-md will-change-transform transition-transform duration-[420ms] ease-[cubic-bezier(.22,1.28,.36,1)] data-[header-state=hidden]:pointer-events-none data-[header-state=hidden]:-translate-y-[102%] data-[header-state=hidden]:scale-y-[.985] data-[header-state=hidden]:duration-[260ms] data-[header-state=hidden]:ease-[cubic-bezier(.45,0,.75,.25)]"
  data-header
  data-header-state="top"
>
  {/* 强调表面单独一层：用透明度淡入代替直接改背景与阴影，切换过程更平顺。 */}
  <span class="pointer-events-none absolute inset-0 border-b border-line bg-glass-strong opacity-0 transition-opacity delay-[40ms] duration-[360ms] ease-soft group-data-[header-state=pinned]:opacity-100" data-header-surface aria-hidden="true"></span>
  <div class="header-inner page-wide relative flex min-h-[70px] items-center justify-between gap-4 md:min-h-[84px] md:gap-6">
    <a class="font-serif text-[15px] tracking-[.2em] whitespace-nowrap min-[520px]:text-[17px] min-[520px]:tracking-[.28em] md:text-[20px]" href={`/${locale}/`} aria-label={`${site.name} — ${t.home}`}>
      {site.name.toUpperCase()}<span class="text-accent tracking-normal">.</span>
    </a>
    <nav id="main-nav" class="hidden items-center gap-7 text-sm text-muted md:flex" aria-label={t.menu}>
      {links.map(link => (
        <a class:list={['relative py-2 transition-colors duration-200 ease-soft hover:text-ink', link.active && 'text-ink']} href={link.href}>
          {link.label}
          {link.active && <span class="absolute -bottom-1 left-1/2 h-1 w-1 -translate-x-1/2 bg-accent"></span>}
        </a>
      ))}
      <span class="h-[18px] w-px bg-line"></span>
      {languageLink.href
        ? <a class="text-[12px] tracking-[.06em] transition-colors duration-200 ease-soft hover:text-ink" href={languageLink.href} lang={other} aria-label={languageLink.aria}>{languageLink.label}</a>
        : <button type="button" class="text-[12px] tracking-[.06em] transition-colors duration-200 ease-soft hover:text-ink" data-modal-button="translation-modal" aria-label={languageLink.aria}>{languageLink.label}<span class="ml-1 text-accent">·</span></button>}
      <a class="grid h-9 w-9 place-items-center text-muted transition-colors duration-200 ease-soft hover:bg-soft hover:text-ink" href={`/${locale}/search/`} aria-label={t.search}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.8"/><path d="m16 16 5 5"/></svg>
      </a>
      <Popover id="settings-desktop" label={t.settings} arrows="none" panelClass="w-[300px]">
        <button slot="trigger" type="button" class="grid h-9 w-9 place-items-center text-muted transition-colors duration-200 ease-soft hover:bg-soft hover:text-ink" aria-expanded="false" aria-haspopup="true" aria-controls="settings-desktop" data-popover-trigger aria-label={t.settings} title={t.settings}>
          {/* 色彩板图标里的颜料点填当前强调色，不必再加额外的小圆点。 */}
          <Icon name="palette" size={19} />
        </button>
        <div class="flex flex-col gap-5">
          <SegmentedControl name="theme" legend={t.theme} options={theme} value="system" />
          <PaletteSwatches name="palette" legend={t.palette} options={palettes} value="slate" />
        </div>
      </Popover>
    </nav>
    <div class="flex items-center gap-1 md:hidden">
      {languageLink.href
        ? <a class="px-2 py-2 text-[12px] tracking-[.06em] text-muted" href={languageLink.href} lang={other} aria-label={languageLink.aria}>{languageLink.label}</a>
        : <button type="button" class="px-2 py-2 text-[12px] tracking-[.06em] text-muted" data-modal-button="translation-modal" aria-label={languageLink.aria}>{languageLink.label}<span class="ml-1 text-accent">·</span></button>}
      <Popover id="settings-mobile" label={t.settings} arrows="none" panelClass="w-[min(300px,calc(100vw-40px))]">
        <button slot="trigger" type="button" class="grid h-9 w-9 place-items-center text-muted transition-colors duration-200 ease-soft hover:bg-soft hover:text-ink" aria-expanded="false" aria-haspopup="true" aria-controls="settings-mobile" data-popover-trigger aria-label={t.settings} title={t.settings}>
          <Icon name="palette" size={19} />
        </button>
        <div class="flex flex-col gap-5">
          <SegmentedControl name="theme-mobile" legend={t.theme} options={theme} value="system" />
          <PaletteSwatches name="palette-mobile" legend={t.palette} options={palettes} value="slate" />
        </div>
      </Popover>
      <IconButton label={t.menu} icon="menu" data-modal-button="mobile-nav" />
    </div>
  </div>
</header>
