---
/**
 * 分段选择：用于主题等少量互斥选项，替代系统下拉框。
 * 键盘与选择行为由 ui/segmented 控制器以事件委托处理；站点内多个分组共享同一状态。
 * `compact` 变体只显示图标，选项名称放进 sr-only，供页头这类空间紧张的位置使用。
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';
interface Props { name: string; legend: string; options: { value: string; label: string; icon?: IconName }[]; value: string; variant?: 'block' | 'compact'; class?: string }
const { name, legend, options, value, variant = 'block', class: className = '' } = Astro.props;
const compact = variant === 'compact';
---
<div class={['js-only inline-flex flex-wrap items-center', compact ? 'gap-0' : 'gap-3', className].join(' ')} data-segmented data-name={name}>
  <span class={compact ? 'sr-only' : 'eyebrow'} id={`${name}-legend`}>{legend}</span>
  <div role="radiogroup" aria-labelledby={`${name}-legend`} class="flex bg-soft p-[3px]">
    {options.map(option => (
      <button
        type="button"
        role="radio"
        aria-checked={option.value === value}
        data-segmented-option
        data-value={option.value}
        data-state={option.value === value ? 'on' : 'off'}
        title={compact ? option.label : undefined}
        class:list={[
          'inline-flex items-center justify-center gap-2 text-muted transition-colors duration-200 ease-soft hover:text-ink data-[state=on]:bg-surface data-[state=on]:text-ink data-[state=on]:shadow-card',
          compact ? 'h-7 w-8 max-[520px]:w-7' : 'px-3 py-1.5 text-[11px] whitespace-nowrap',
        ]}
      >
        {option.icon && <Icon name={option.icon} size={compact ? 15 : 14} />}
        <span class={compact ? 'sr-only' : ''}>{option.label}</span>
      </button>
    ))}
  </div>
</div>
