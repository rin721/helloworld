---
/**
 * 浮层：由按钮触发的浮层（链接列表或设置面板），替代 details 下拉。
 * 控制器负责外部点击、Escape 与焦点返回；`arrows="none"` 时把方向键让给面板内的自定义控件
 * （例如设置浮层里的 radiogroup），避免两套键盘约定互相抢。
 * 无脚本时只显示面板外的静态回退入口。
 */
import Icon from './Icon.astro';
interface Props { id: string; label: string; align?: 'start' | 'end'; arrows?: 'links' | 'none'; panelClass?: string; class?: string }
const { id, label, align = 'end', arrows = 'links', panelClass = '', class: className = '' } = Astro.props;
const hasCustomTrigger = Astro.slots.has('trigger');
---
<div class={['js-only relative', className].join(' ')} data-popover data-open="false">
  {hasCustomTrigger ? <slot name="trigger" /> : (
    <button
      type="button"
      class="flex items-center gap-2 px-3 py-2 text-[11px] text-muted transition-colors duration-200 ease-soft hover:bg-soft hover:text-ink"
      aria-expanded="false"
      aria-haspopup="true"
      aria-controls={id}
      data-popover-trigger
    >
      <span>{label}</span>
      <Icon name="chevron-down" size={14} class="disclosure-chevron" />
    </button>
  )}
  <div
    id={id}
    class={['popover-panel absolute top-[calc(100%+8px)] z-30 min-w-[220px] max-w-[320px] rounded-card border border-line bg-surface p-4', align === 'end' ? 'right-0' : 'left-0', panelClass].join(' ')}
    role="group"
    aria-label={label}
    data-popover-panel
    data-popover-arrows={arrows}
    hidden
  >
    <slot />
  </div>
</div>
