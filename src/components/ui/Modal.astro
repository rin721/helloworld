---
/**
 * 模态层：译文提示、图片查看和移动导航共用。
 * 控制器负责焦点循环、背景 inert、滚动锁定、Escape、遮罩点击与关闭后焦点恢复。
 */
import IconButton from './IconButton.astro';
interface Props { id: string; labelledby: string; closeLabel: string; title?: string; size?: 'sm' | 'md' | 'wide'; variant?: 'panel' | 'bare'; class?: string }
const { id, labelledby, closeLabel, title, size = 'md', variant = 'panel', class: className = '' } = Astro.props;
const widths = { sm: 'max-w-[460px]', md: 'max-w-[580px]', wide: 'max-w-[min(1200px,94vw)]' }[size];
const surface = variant === 'bare'
  ? 'rounded-none border-0 bg-transparent p-0'
  : ['rounded-card border border-line bg-surface', size === 'wide' ? 'p-4 md:p-6' : 'p-6 md:p-8'].join(' ');
---
<div id={id} class="fixed inset-0 z-50" data-modal hidden>
  <div class="overlay" data-modal-overlay></div>
  <div class="relative z-10 flex min-h-full items-center justify-center p-4 md:p-6">
    <div
      class={['modal-panel relative w-full', surface, widths, className].join(' ')}
      role="dialog"
      aria-modal="true"
      aria-labelledby={labelledby}
      tabindex="-1"
      data-modal-panel
    >
      <div class="mb-5 flex items-start justify-between gap-4">
        {title ? <p class="eyebrow" id={labelledby}>{title}</p> : <span id={labelledby} class="sr-only">{closeLabel}</span>}
        <IconButton label={closeLabel} icon="close" size="sm" variant="plain" class="-mt-1 -mr-1" data-modal-close />
      </div>
      <slot />
    </div>
  </div>
</div>
