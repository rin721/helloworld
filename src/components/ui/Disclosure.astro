---
/**
 * 展开区域：替代 details/summary。
 * 无脚本时区域始终展开（移动目录仍可阅读），触发按钮只在脚本就绪后显示。
 */
import Icon from './Icon.astro';
interface Props { id: string; summary: string; open?: boolean; variant?: 'inline' | 'block'; class?: string }
const { id, summary, open = false, variant = 'inline', class: className = '' } = Astro.props;
---
<div class={className} data-disclosure data-open={open ? 'true' : 'false'}>
  <button
    type="button"
    class="disclosure-trigger flex w-full items-center justify-between gap-4 text-left"
    aria-expanded={open ? 'true' : 'false'}
    aria-controls={id}
    data-disclosure-trigger
  >
    <span class={variant === 'block' ? 'eyebrow' : 'text-[13px] text-ink'}>{summary}</span>
    <Icon name="chevron-down" size={16} class="disclosure-chevron shrink-0 text-faint" />
  </button>
  <div class="disclosure-region" id={id} data-state={open ? 'open' : 'closed'} data-disclosure-region>
    <div><div class="pt-4"><slot /></div></div>
  </div>
</div>
