---
/** 标签：文章标签与元信息使用的小组件，可作为链接或纯文本。 */
interface Props { [key: string]: unknown; href?: string; variant?: 'quiet' | 'solid'; class?: string }
const { href, variant = 'quiet', class: className = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'span';
const surface = variant === 'solid' ? 'bg-accent-soft text-accent' : 'text-faint hover:bg-soft hover:text-accent';
---
<Tag href={href} class={['inline-flex items-center px-[9px] py-[3px] text-[10px] leading-normal tracking-[.04em] transition-colors duration-200 ease-soft', surface, className].join(' ')} {...rest}>
  <slot />
</Tag>
