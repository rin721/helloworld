---
/**
 * 面板：站点的基本表面。圆角、无阴影，靠底色与页面区分层次。
 * 所有卡片、浮层内容、页头与侧栏都由它派生，页面只调整间距与网格。
 * `lift` 只改变底色（悬停与键盘焦点一致），不再有位移与投影。
 */
interface Props {
  [key: string]: unknown;
  as?: 'div' | 'section' | 'article' | 'aside' | 'nav' | 'header' | 'footer' | 'figure' | 'li';
  variant?: 'surface' | 'glass' | 'soft' | 'plain';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  lift?: boolean;
  class?: string;
}
const { as: Tag = 'div', variant = 'surface', padding = 'md', lift = false, class: className = '', ...rest } = Astro.props;
const surfaces = {
  surface: 'bg-surface',
  glass: 'bg-glass backdrop-blur-md',
  soft: 'bg-soft',
  plain: 'bg-transparent',
}[variant];
const paddings = { none: '', sm: 'p-4', md: 'p-6', lg: 'p-7 md:p-10' }[padding];
/* 悬停反馈必须用工具类：utilities 层优先于组件层，写在 global.css 里会被 bg-surface 盖掉。 */
const hoverSurface = 'hover:bg-[color-mix(in_srgb,var(--c-surface)_76%,var(--c-soft))] focus-within:bg-[color-mix(in_srgb,var(--c-surface)_76%,var(--c-soft))]';
const hoverGlass = 'hover:bg-glass-strong focus-within:bg-glass-strong';
const hover = lift ? ['transition-colors duration-200 ease-soft', variant === 'glass' ? hoverGlass : hoverSurface].join(' ') : '';
---
<Tag class={[surfaces, paddings, hover, 'relative rounded-card', className].join(' ')} {...rest}>
  <slot />
</Tag>
