---
/**
 * 面板：站点的基本表面。直角矩形、柔和阴影、可选半透明材质。
 * 所有卡片、浮层内容、页头与侧栏都由它派生，页面只调整间距与网格。
 */
interface Props {
  [key: string]: unknown;
  as?: 'div' | 'section' | 'article' | 'aside' | 'nav' | 'header' | 'footer' | 'figure' | 'li';
  variant?: 'surface' | 'glass' | 'soft' | 'plain';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  lift?: boolean;
  class?: string;
}
const { as: Tag = 'div', variant = 'surface', padding = 'md', lift = false, class: className = '', ...rest } = Astro.props;
const surfaces = {
  surface: 'bg-surface shadow-card',
  glass: 'bg-glass backdrop-blur-md',
  soft: 'bg-soft',
  plain: 'bg-transparent',
}[variant];
const paddings = { none: '', sm: 'p-4', md: 'p-6', lg: 'p-7 md:p-10' }[padding];
---
<Tag class={[surfaces, paddings, lift ? 'lift' : '', 'relative', className].join(' ')} {...rest}>
  <slot />
</Tag>
