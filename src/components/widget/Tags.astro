---

import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getTagList } from "../../utils/content-utils";
import { type AppLocale, defaultLocale } from "../../utils/locale";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	locale?: AppLocale;
}
const { locale = defaultLocale, class: className, style } = Astro.props;

const tags = await getTagList(locale);

const COLLAPSED_HEIGHT = "7.5rem";

const isCollapsed = tags.length >= 20;
---
<WidgetLayout name={i18n(I18nKey.tags, locale)} id="tags" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT} locale={locale} class={className} style={style}>
    <div class="flex gap-2 flex-wrap">
        {tags.map(t => (
            <ButtonTag href={getTagUrl(t.name, locale)} label={`${i18n(I18nKey.viewTag, locale)} ${t.name.trim()}`}>
                {t.name.trim()}
            </ButtonTag>
        ))}
    </div>
</WidgetLayout>
