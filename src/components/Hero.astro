---
/** 首页首屏：几何背景、介绍面板、错位的精选卡片与滚动提示。 */
import { site, labels, type Locale } from '../config';
import type { Post } from '../lib/posts';
import Backdrop from './Backdrop.astro';
import Card from './Card.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
interface Props { locale: Locale; featured?: Post }
const { locale, featured } = Astro.props;
const t = labels[locale];
---
<section class="hero relative isolate overflow-hidden bg-[image:var(--backdrop-base)] pt-10 pb-4 text-ink md:pt-14 lg:min-h-[740px] lg:pt-[70px] xl:min-h-[820px]" aria-labelledby="hero-title">
  <Backdrop variant="home" />
  <div class="hero-content page-wide relative">
    <div class="hero-panel panel-highlight relative max-w-[670px] bg-glass px-6 py-9 backdrop-blur-md md:px-10 md:py-11 lg:px-[55px] lg:py-[43px]">
      <p class="eyebrow hero-kicker mb-5 text-[9px] text-accent">A JOURNAL OF EVERYDAY DISCOVERIES</p>
      <h1 id="hero-title" class="font-serif text-[clamp(44px,9vw,91px)] leading-[1.03] font-normal tracking-[-.065em] whitespace-nowrap text-ink">{site.name}<span class="text-accent">.</span></h1>
      <p class="hero-subtitle mt-6 font-serif text-[21px] leading-[1.65] tracking-[.03em] whitespace-pre-line text-muted md:text-[24px]">{site.introduction[locale]}</p>
      <p class="hero-description mt-5 max-w-[390px] text-[12px] leading-[1.95] text-muted md:text-[13px]">{site.description[locale]}</p>
      <Button href="#journal" icon="arrow-right" class="primary-link mt-7 min-w-[190px]">{t.read}</Button>
    </div>
    <p class="margin-note hero-note absolute top-[78px] right-[2.5%] hidden text-[color:var(--c-on-backdrop)] lg:block" aria-hidden="true">SAME<br/>SKIES<br/>DIFFERENT<br/>THOUGHTS<span class="my-6 block h-px w-[26px] bg-current"></span></p>
  </div>
  <div class="hero-bottom page-wide relative mt-8 flex justify-end">
    <p class="margin-note lower-note absolute top-2.5 left-0 hidden text-muted lg:block" aria-hidden="true"><span class="my-6 block h-px w-[26px] bg-current"></span>SLOWER<br/>DEEPER<br/>A LITTLE<br/>CLOSER</p>
    {featured && (
      <div class="relative w-full lg:w-[86%] xl:w-[80%]">
        <div class="backdrop-depth absolute top-[-24px] right-[-18px] bottom-[-24px] left-0 z-[-1]" data-depth="mid" aria-hidden="true"><div class="backdrop-plate" style="animation-delay:0ms"></div></div>
        <Card post={featured} featured />
      </div>
    )}
  </div>
  <a class="scroll-cue mt-7 mb-6 flex items-center justify-center gap-3 text-[8px] tracking-[.23em] text-muted" href="#journal" aria-label={locale === 'zh' ? '浏览最近记录' : 'Browse entries'}>
    SCROLL TO EXPLORE <Icon name="arrow-right" size={14} class="rotate-90" />
  </a>
</section>
