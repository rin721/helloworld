---
/** 内容卡片：单列内容流的基本单元，自带表面、内边距与悬停抬升，不使用分隔线。 */
import { Image } from 'astro:assets';
import { labels, formatDate } from '../config';
import { postCover, type Post } from '../lib/posts';
import Panel from './ui/Panel.astro';
import Tag from './ui/Tag.astro';
import Icon from './ui/Icon.astro';
interface Props { post: Post; featured?: boolean; index?: number }
const { post, featured = false, index } = Astro.props;
const { locale } = post;
const t = labels[locale];
const cover = await postCover(post);
const kindLabel = featured ? t.featured : post.data.layout === 'gallery' ? t.gallery : t[post.data.kind];
---
<Panel
  as="article"
  variant={featured ? 'glass' : 'surface'}
  padding="none"
  lift
  class:list={['entry-card group flex flex-col overflow-hidden md:flex-row', featured && 'featured-card']}
  data-motion-item
>
  {cover && (
    <a class="card-image-link block w-full shrink-0 overflow-hidden bg-soft md:w-[280px]" href={post.url} tabindex="-1" aria-hidden="true">
      <Image src={cover} alt="" widths={[400, 720]} sizes="(max-width: 680px) 90vw, 320px" loading={featured ? 'eager' : 'lazy'} class="h-full w-full object-cover transition-transform duration-500 ease-soft group-hover:scale-[1.03]" />
    </a>
  )}
  <div class="card-body flex min-w-0 flex-1 flex-col gap-3 p-6 md:py-7">
    <div class="card-meta flex items-center justify-between gap-3 text-[10px] tracking-[.12em] text-accent">
      <span class="flex items-center gap-2">
        {index !== undefined && !cover && <span class="entry-number font-serif text-[15px] text-faint">{String(index).padStart(2, '0')}</span>}
        {kindLabel}
        {!featured && post.data.pinnedOrder !== undefined && <span class="pin-label text-faint">/ {t.pinned}</span>}
      </span>
      <time class="text-[10px] tracking-[.04em] whitespace-nowrap text-faint" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
    </div>
    <h2 class:list={['font-serif leading-snug font-normal', featured ? 'text-[24px] md:text-[28px]' : 'text-[21px] md:text-[25px]']}>
      <a class="transition-colors duration-200 ease-soft hover:text-accent" href={post.url}>{post.data.title}</a>
    </h2>
    {post.excerpt && <p class="card-excerpt line-clamp-2 text-[13px] leading-[1.85] text-muted">{post.excerpt}</p>}
    <div class="card-bottom mt-auto flex items-center justify-between gap-4 pt-1">
      <div class="tag-list flex flex-wrap items-center gap-2">
        {post.data.tags.map(tag => <Tag href={`/${locale}/tags/${encodeURIComponent(tag)}/`}>#{tag}</Tag>)}
        {post.data.draft && <Tag variant="solid">{t.draft}</Tag>}
      </div>
      <a class="card-arrow lift-arrow grid h-9 w-9 shrink-0 place-items-center bg-soft text-accent" href={post.url} aria-label={`${t.more}：${post.data.title}`}>
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </div>
</Panel>
