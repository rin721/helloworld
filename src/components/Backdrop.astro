---
/**
 * 背景构图组件：以错位、叠放、局部裁切的矩形面板建立空间层次。
 *
 * 三个变体：
 * - `home`：完整层次，放在首页首屏 `.hero` 内，包含远层、中层与入场动效。
 * - `page`：内页只使用固定底色，不包含装饰面板、线条或投影。
 * - `minimal`：搜索与 404 使用同样的干净底色，保留变体接口。
 *
 * 面板的位置、尺寸、透明度与响应式由 Tailwind 工具类给出；颜色、投影与边缘高光取自
 * `src/styles/global.css` 中的背景层次变量；面板表面与入场动效定义在该文件的 `.backdrop*` 规则中。
 * 每层面板的 `--backdrop-fill` 与 `animation-delay` 使用内联自定义属性：它们不参与工具类扫描，
 * 且内联样式不会被无 @layer 的项目 CSS 覆盖。所有背景内容 `aria-hidden` 且不接收指针事件。
 */
interface Props { variant?: 'home' | 'page' | 'minimal' }
const { variant = 'page' } = Astro.props;
---

{variant === 'home' && (
  <div class="backdrop" data-backdrop="home" aria-hidden="true">
    {/* 远层几何：右上与左下各一个大矩形，部分超出容器裁切，低对比度建立画面尺度。 */}
    <div class="backdrop-depth absolute z-[1] top-[-9%] right-[-7%] h-[76%] w-[33%] opacity-90 max-md:top-[-8%] max-md:right-[-14%] max-md:h-[42%] max-md:w-[54%]" data-depth="far" style="--backdrop-fill:var(--backdrop-far-1)">
      <div class="backdrop-enter" style="animation-delay:0ms"><div class="backdrop-panel"></div></div>
    </div>
    <div class="backdrop-depth absolute z-[1] bottom-[-14%] left-[-10%] hidden h-[64%] w-[36%] opacity-85 md:block" data-depth="far" style="--backdrop-fill:var(--backdrop-far-2)">
      <div class="backdrop-enter" style="animation-delay:70ms"><div class="backdrop-panel"></div></div>
    </div>
    {/* 中层卡片：右侧三张不同尺寸的面板，横向与纵向交错，按 DOM 顺序形成可辨认的遮挡。 */}
    <div class="backdrop-depth absolute z-[2] right-[-8%] bottom-[2%] h-[30%] w-[56%] opacity-90 md:top-[6%] md:right-[8%] md:bottom-auto md:h-[46%] md:w-[22%]" data-depth="mid" style="--backdrop-fill:var(--backdrop-mid-1)">
      <div class="backdrop-enter" style="animation-delay:140ms"><div class="backdrop-panel"></div></div>
    </div>
    <div class="backdrop-depth absolute z-[3] hidden opacity-75 md:top-[34%] md:right-[20%] md:block md:h-[38%] md:w-[17%]" data-depth="mid" style="--backdrop-fill:var(--backdrop-mid-2)">
      <div class="backdrop-enter" style="animation-delay:210ms"><div class="backdrop-panel backdrop-panel-soft"></div></div>
    </div>
    <div class="backdrop-depth absolute z-[4] hidden opacity-85 md:top-[54%] md:right-[12%] md:block md:h-[30%] md:w-[16%]" data-depth="mid" style="--backdrop-fill:var(--backdrop-mid-3)">
      <div class="backdrop-enter" style="animation-delay:280ms"><div class="backdrop-panel"></div></div>
    </div>
    {/* 少量细线：介绍面板上方的短横线，延续参考图的线性细节。 */}
    <div class="backdrop-hairline left-[10%] top-[4%] h-px w-[7%]"></div>
    <div class="backdrop-grain"></div>
  </div>
)}

{variant !== 'home' && (
  <div class="backdrop" data-backdrop={variant} aria-hidden="true"></div>
)}
