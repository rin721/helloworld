---
/** 分页：真实静态链接，当前页用一个实心方块标记，其余保持轻量表面。 */
import { labels, type Locale } from '../config';
import { listPath } from '../lib/posts';
import Button from './ui/Button.astro';
interface Props { locale: Locale; page: number; total: number; filter?: { type: 'tags' | 'types'; value: string } }
const { locale, page, total, filter } = Astro.props;
const t = labels[locale];
const numbers = Array.from({ length: total }, (_, i) => i + 1).filter(n => n === 1 || n === total || Math.abs(n - page) <= 2);
---
{total > 1 && (
  <nav class="pagination my-12 flex flex-wrap items-center justify-between gap-5" aria-label={locale === 'zh' ? '分页' : 'Pagination'}>
    {page > 1
      ? <Button href={`${listPath(locale, page - 1, filter)}#journal`} variant="quiet" size="sm" icon="arrow-left" iconPosition="start" rel="prev">{t.previous}</Button>
      : <Button variant="quiet" size="sm" icon="arrow-left" iconPosition="start" disabled>{t.previous}</Button>}
    <div class="flex items-center gap-1.5 text-[12px] text-muted">
      {numbers.map((n, i) => (
        <>
          {i > 0 && n - numbers[i - 1] > 1 && <span class="px-1 text-faint">…</span>}
          <a
            class:list={[
              'grid h-9 min-w-9 place-items-center transition-colors duration-200 ease-soft',
              n === page ? 'bg-accent text-on-accent' : 'hover:bg-soft hover:text-ink',
            ]}
            href={`${listPath(locale, n, filter)}#journal`}
            aria-current={n === page ? 'page' : undefined}
          >{String(n).padStart(2, '0')}</a>
        </>
      ))}
    </div>
    {page < total
      ? <Button href={`${listPath(locale, page + 1, filter)}#journal`} variant="outline" size="sm" icon="arrow-right" rel="next">{t.next}</Button>
      : <Button variant="quiet" size="sm" icon="arrow-right" disabled>{t.next}</Button>}
  </nav>
)}
