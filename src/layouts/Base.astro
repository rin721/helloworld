---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Backdrop from '../components/Backdrop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileNav from '../components/MobileNav.astro';
import TranslationModal from '../components/TranslationModal.astro';
import Lightbox from '../components/Lightbox.astro';
import { site, labels, type Locale } from '../config';
interface Props { locale?: Locale; title: string; description?: string; image?: string; article?: boolean; translationUrl?: string | null; hreflangUrl?: string | null; publishedAt?: Date; noindex?: boolean; backdrop?: 'page' | 'minimal' | 'none' }
const { locale = 'zh', title, description = site.description[locale], image, article = false, translationUrl, hreflangUrl, publishedAt, noindex = false, backdrop = 'page' } = Astro.props;
const other = locale === 'zh' ? 'en' : 'zh';
const path = Astro.url.pathname;
const canonical = new URL(path === '/404/' ? '/404.html' : path, Astro.site);
const alternate = translationUrl === null ? null : translationUrl ?? path.replace(`/${locale}/`, `/${other}/`);
const alternateMetadata = hreflangUrl === undefined ? alternate : hreflangUrl;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const schema = { '@context': 'https://schema.org', '@type': article ? 'BlogPosting' : 'WebSite', name: title, headline: article ? title : undefined, description, url: canonical.href, inLanguage: locale === 'zh' ? 'zh-CN' : 'en', author: { '@type': 'Person', name: site.author.name }, datePublished: publishedAt?.toISOString(), image: ogImage };
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title === site.name ? title : `${title} · ${site.name}`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang={locale === 'zh' ? 'zh-CN' : 'en'} href={canonical} />}
    {!noindex && alternateMetadata && <link rel="alternate" hreflang={other === 'zh' ? 'zh-CN' : 'en'} href={new URL(alternateMetadata, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · ${locale}`} href={`/${locale}/rss.xml`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <ClientRouter />
    {/* 主题、配色与会话状态必须在绘制前写到根元素：内联脚本本身只执行一次，
        但它在 after-swap 里写回属性，因此软导航后不会闪回默认主题或配色，
        `js` 类也不会丢失（脚本专属控件与折叠区域都依赖它）。 */}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        // 与 src/scripts/ui/palette.ts 的 PALETTE_KEY 和名单保持一致（单元测试会核对键名）。
        const palettes = ['slate', 'jade', 'violet', 'clay', 'graphite'];
        function resolve(mode) {
          return mode === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : mode;
        }
        function apply() {
          root.classList.add('js');
          // 软导航时背景不再重播入场，标记供 CSS 使用。
          if (document.querySelector('[data-backdrop]') && root.dataset.navigation !== 'soft') root.dataset.navigation = 'soft';
          let mode = 'system';
          try { const stored = localStorage.getItem('theme'); if (stored === 'light' || stored === 'dark') mode = stored; } catch { /* 隐私模式下按系统处理。 */ }
          root.dataset.theme = mode;
          root.dataset.resolvedTheme = resolve(mode);
          let palette = 'slate';
          try { const stored = localStorage.getItem('palette'); if (stored && palettes.indexOf(stored) >= 0) palette = stored; } catch { /* 隐私模式下按默认配色处理。 */ }
          root.dataset.palette = palette;
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body data-locale={locale}>
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-4 focus:z-50 focus:bg-surface focus:px-5 focus:py-3" href="#main">{labels[locale].skip}</a>
    <div id="page-shell">
      <SiteHeader locale={locale} path={path} alternate={alternate} />
      <main id="main">{backdrop !== 'none' && <Backdrop variant={backdrop} />}<slot /></main>
      <SiteFooter locale={locale} />
    </div>
    <MobileNav locale={locale} alternate={alternate} />
    <TranslationModal locale={locale} />
    <Lightbox locale={locale} />
    <script>import '../scripts/interactions';</script>
  </body>
</html>
