---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Card from '../../components/Card.astro';
import Pagination from '../../components/Pagination.astro';
import Panel from '../../components/ui/Panel.astro';
import Popover from '../../components/ui/Popover.astro';
import Icon from '../../components/ui/Icon.astro';
import { listRoutes, type Post } from '../../lib/posts';
import { labels, site, type Locale } from '../../config';
export const getStaticPaths = listRoutes;
interface Props { locale: Locale; items: Post[]; all: Post[]; page: number; total: number; count: number; filter?: { type: 'tags' | 'types'; value: string } }
const { locale, items, all, page, total, count, filter } = Astro.props;
const t = labels[locale];
const first = !filter && page === 1;
const chronological = [...all].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const featured = chronological.find(p => p.data.featured) ?? chronological[0];
const tags = [...new Set(all.flatMap(p => p.data.tags))].sort();
const heading = filter ? filter.type === 'tags' ? `#${filter.value}` : t[filter.value as 'article' | 'diary' | 'note'] : t.latest;
const Heading = first ? 'h2' : 'h1';
const other = locale === 'zh' ? 'en' : 'zh';
const alternate = filter?.type === 'tags' ? `/${other}/tags/` : filter ? `/${other}/types/${filter.value}/` : `/${other}/`;
const kinds = ['article', 'diary', 'note'] as const;
---
<Base locale={locale} title={first ? site.name : `${heading}${page > 1 ? ` · ${page}` : ''}`} translationUrl={alternate} hreflangUrl={filter?.type === 'tags' || page > 1 ? null : alternate} backdrop={first ? 'none' : 'page'}>
  {first && <Hero locale={locale} featured={featured} />}
  <section id="journal" class:list={['journal-section page-width pt-16 md:pt-[85px]', !first && 'min-h-[60vh]']}>
    <div class="section-heading mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">THE JOURNAL</p>
        <Heading class:list={['section-title mt-3 font-serif text-[30px] leading-tight font-normal tracking-[.025em] md:text-[36px]', filter && 'filtered-title']}>
          {heading}<span class="text-accent">.</span>
        </Heading>
      </div>
      <p class="section-note text-[12px] leading-[1.9] text-muted md:text-right">
        {locale === 'zh' ? '一些思考，一些日常，一些值得留下的瞬间。' : 'Thoughts, moments, and things worth keeping.'}
        <br class="hidden md:block" />
        <span class="text-[10px] text-faint">{count} {locale === 'zh' ? '篇记录' : 'entries'}</span>
      </p>
    </div>

    <div class="filter-bar mb-8 flex flex-wrap items-center justify-between gap-4 bg-soft px-5 py-3">
      <nav class="type-filters flex flex-wrap items-center gap-1 text-[12px] text-muted" aria-label={t.types}>
        <a class:list={['px-4 py-2 transition-colors duration-200 ease-soft', !filter ? 'bg-surface text-ink shadow-card' : 'hover:bg-surface hover:text-ink']} href={`/${locale}/#journal`} aria-current={!filter ? 'page' : undefined}>{t.all}</a>
        {kinds.map(kind => (
          <a
            class:list={['px-4 py-2 transition-colors duration-200 ease-soft', filter?.type === 'types' && filter.value === kind ? 'bg-surface text-ink shadow-card' : 'hover:bg-surface hover:text-ink']}
            href={`/${locale}/types/${kind}/`}
            aria-current={filter?.type === 'types' && filter.value === kind ? 'page' : undefined}
          >{t[kind]}</a>
        ))}
      </nav>
      <a class="no-js-only flex items-center gap-2 px-3 py-2 text-[11px] text-muted hover:text-ink" href={`/${locale}/tags/`}>{t.tags}<Icon name="arrow-up-right" size={14} /></a>
      <Popover id="tag-filter-panel" label={filter?.type === 'tags' ? `#${filter.value}` : t.tags}>
        <div class="flex max-h-[320px] flex-col overflow-y-auto">
          {tags.map(tag => (
            <a class="px-3 py-2 text-[12px] text-muted transition-colors duration-200 ease-soft hover:bg-soft hover:text-ink" href={`/${locale}/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
          <a class="mt-1 flex items-center justify-between px-3 py-2 text-[11px] text-accent" href={`/${locale}/tags/`}>{t.allTags}<Icon name="arrow-right" size={14} /></a>
        </div>
      </Popover>
    </div>

    <div class="entry-list flex flex-col gap-6">
      {items.length
        ? items.map((post, i) => <Card post={post} index={(page - 1) * site.pageSize + i + 1} />)
        : <Panel variant="soft" padding="lg" class="text-center text-muted">{t.empty}</Panel>}
    </div>

    <Pagination locale={locale} page={page} total={total} filter={filter} />

    <div class="journal-end mt-16 mb-20 flex items-center justify-center gap-5 font-serif text-[13px] text-faint italic">
      <p>{locale === 'zh' ? '日常很小，也值得被看见。' : 'Small things, seen a little more closely.'}</p>
    </div>
  </section>
</Base>
