---
import Base from '../../layouts/Base.astro';
import Panel from '../../components/ui/Panel.astro';
import Icon from '../../components/ui/Icon.astro';
import { localizedPosts } from '../../lib/posts';
import { labels, locales, formatDate } from '../../config';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props;
const t = labels[locale];
const posts = (await localizedPosts(locale)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const groups = Map.groupBy(posts, p => p.data.publishedAt.toISOString().slice(0, 7));
---
<Base locale={locale} title={t.archive}>
  <section class="standard-page page-width pt-14 pb-24 md:pt-[75px]">
    <header class="relative mb-12 bg-soft px-7 py-9 md:px-10 md:py-12">
      <span class="geo-slice" aria-hidden="true"></span>
      <p class="eyebrow">A COLLECTION OF MOMENTS</p>
      <h1 class="page-title mt-3 font-serif text-[38px] leading-tight font-normal md:text-[54px]">{t.archive}<span class="text-accent">.</span></h1>
      <p class="page-intro mt-4 max-w-[560px] font-serif text-[17px] text-muted md:text-[18px]">{locale === 'zh' ? '沿着时间的线索，重访那些写下的瞬间。' : 'Follow the thread of time. Revisit the moments we kept.'}</p>
    </header>
    {posts.length === 0 && <Panel variant="soft" padding="lg" class="text-center text-muted">{t.empty}</Panel>}
    <div class="archive flex flex-col gap-6">
      {[...groups].map(([month, entries]) => (
        <Panel as="section" padding="lg" class="archive-group">
          <div class="grid grid-cols-[56px_16px_minmax(0,1fr)] gap-x-3 sm:grid-cols-[136px_20px_minmax(0,1fr)] sm:gap-x-5">
            <h2 class="pb-6 font-serif text-[18px] leading-7 font-normal text-ink sm:text-[22px]">
              <span class="block sm:inline">{month.slice(0, 4)}</span><span class="block text-sm text-muted sm:ml-2 sm:inline sm:text-[22px]">/ {month.slice(5)}</span>
            </h2>
            <span class="relative flex justify-center self-stretch" aria-hidden="true">
              <span class="absolute top-3.5 bottom-0 left-1/2 -translate-x-1/2 border-l border-dashed border-line-strong"></span>
              <span class="relative mt-2 h-3 w-3 rounded-full border-2 border-accent bg-surface"></span>
            </span>
            <span class="pt-1 text-[11px] text-faint">{entries.length} {locale === 'zh' ? '篇' : 'entries'}</span>
          </div>
          <div>
            {entries.map((p, index) => (
              <a class="archive-entry group grid grid-cols-[56px_16px_minmax(0,1fr)] gap-x-3 transition-colors duration-200 ease-soft hover:bg-soft focus-visible:bg-soft sm:grid-cols-[136px_20px_minmax(0,1fr)] sm:gap-x-5" href={p.url}>
                <time class="pt-3 text-[11px] leading-[27px] text-faint" datetime={p.data.publishedAt.toISOString()}>
                  <span class="sm:hidden">{p.data.publishedAt.toISOString().slice(5, 10)}</span>
                  <span class="hidden sm:inline">{formatDate(p.data.publishedAt, locale)}</span>
                </time>
                <span class="relative flex justify-center self-stretch" aria-hidden="true">
                  <span class:list={['absolute top-0 left-1/2 -translate-x-1/2 border-l border-dashed border-line-strong', index === entries.length - 1 ? 'h-[25px]' : 'bottom-0']}></span>
                  <span class="relative mt-[23px] h-1 w-1 rounded-full bg-accent transition-transform duration-200 ease-soft group-hover:scale-150 group-focus-visible:scale-150"></span>
                </span>
                <span class="flex min-w-0 flex-wrap items-baseline gap-x-4 gap-y-1 py-3">
                  <span class="min-w-0 basis-full break-words font-serif text-[18px] leading-[27px] text-ink group-hover:text-accent sm:flex-1 sm:basis-auto">{p.data.title}</span>
                  <small class="text-[11px] text-muted">{t[p.data.kind]}</small>
                  <Icon name="arrow-up-right" size={14} class="ml-auto shrink-0 text-faint transition-transform duration-200 ease-soft group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </span>
              </a>
            ))}
          </div>
        </Panel>
      ))}
    </div>
  </section>
</Base>
