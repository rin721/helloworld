---
import Base from '../../../layouts/Base.astro';
import Panel from '../../../components/ui/Panel.astro';
import Icon from '../../../components/ui/Icon.astro';
import { localizedPosts } from '../../../lib/posts';
import { labels, locales } from '../../../config';
export function getStaticPaths() {
  return locales.flatMap(locale => (['tags', 'types'] as const).map(taxonomy => ({ params: { locale, taxonomy }, props: { locale, taxonomy } })));
}
const { locale, taxonomy } = Astro.props;
const t = labels[locale];
const posts = await localizedPosts(locale);
const values = taxonomy === 'tags' ? [...new Set(posts.flatMap(p => p.data.tags))].sort() : ['article', 'diary', 'note'];
const isTags = taxonomy === 'tags';
---
<Base locale={locale} title={t[taxonomy]}>
  <section class="standard-page page-width pt-14 pb-24 md:pt-[75px]">
    <header class="relative mb-12 rounded-card bg-soft px-7 py-9 md:px-10 md:py-12">
      <span class="pointer-events-none absolute inset-0 overflow-hidden rounded-card" aria-hidden="true"><span class="geo-slice"></span></span>
      <p class="eyebrow">FIND YOUR OWN THREAD</p>
      <h1 class="page-title mt-3 font-serif text-[38px] leading-tight font-normal md:text-[54px]">{t[taxonomy]}<span class="text-accent">.</span></h1>
      <p class="page-intro mt-4 max-w-[560px] font-serif text-[17px] text-muted md:text-[18px]">{locale === 'zh' ? '从一个词开始，发现相互连接的故事。' : 'Begin with a word. Find the stories that connect.'}</p>
    </header>

    <div class:list={['taxonomy-grid grid gap-5', isTags ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' : 'grid-cols-1 md:grid-cols-3']}>
      {values.map(value => {
        const count = posts.filter(p => isTags ? p.data.tags.includes(value) : p.data.kind === value).length;
        const label = isTags ? `#${value}` : t[value as 'article' | 'diary' | 'note'];
        return (
          <Panel as="article" padding="none" lift class="group relative" data-motion-item>
            <a class="flex h-full flex-col justify-between p-6" href={`/${locale}/${taxonomy}/${encodeURIComponent(value)}/`}>
              <span class="pointer-events-none absolute inset-0 overflow-hidden rounded-card" aria-hidden="true"><span class="geo-slice"></span></span>
              <h2 class="relative mb-10 font-serif text-[22px] leading-snug font-normal break-words text-ink">{label}</h2>
              <span class="relative flex items-center justify-between gap-3 text-[11px] text-faint">
                {count} {locale === 'zh' ? '篇记录' : 'entries'}
                <span class="grid h-8 w-8 place-items-center rounded-control bg-soft text-accent transition-transform duration-200 ease-soft group-hover:translate-x-[3px] group-hover:-translate-y-[3px] group-focus-within:translate-x-[3px] group-focus-within:-translate-y-[3px]"><Icon name="arrow-up-right" size={15} /></span>
              </span>
            </a>
          </Panel>
        );
      })}
    </div>
    {values.length === 0 && <Panel variant="soft" padding="lg" class="text-center text-muted">{t.empty}</Panel>}
  </section>
</Base>
