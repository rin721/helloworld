---
import Base from '../../layouts/Base.astro';
import Panel from '../../components/ui/Panel.astro';
import Button from '../../components/ui/Button.astro';
import SearchInput from '../../components/ui/SearchInput.astro';
import { labels, locales } from '../../config';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props;
const t = labels[locale];
---
<Base locale={locale} title={t.search} backdrop="minimal">
  <section class="standard-page page-width search-page pt-14 pb-24 md:pt-[75px]">
    <header class="relative mb-10 bg-soft px-7 py-9 md:px-10 md:py-11">
      <span class="geo-slice" aria-hidden="true"></span>
      <p class="eyebrow">SOMETHING YOU'RE LOOKING FOR</p>
      <h1 class="page-title mt-3 font-serif text-[38px] leading-tight font-normal md:text-[54px]">{t.search}<span class="text-accent">.</span></h1>
      <p class="page-intro mt-4 max-w-[560px] font-serif text-[17px] text-muted md:text-[18px]">{t.searchHint}</p>
    </header>

    <SearchInput id="search-input" label={t.searchLabel} placeholder={t.searchPlaceholder} value="" clearLabel={locale === 'zh' ? '清空搜索' : 'Clear search'} submitLabel={t.search} />

    <div class="mt-7 flex flex-wrap items-center justify-between gap-4">
      <p id="search-status" role="status" aria-live="polite" class="text-[13px] text-muted">{t.searchHint}</p>
      <Button id="search-retry" variant="outline" size="sm" icon="retry" iconPosition="start" hidden>{t.retry}</Button>
    </div>

    <div id="search-results" class="mt-4 flex flex-col gap-4"></div>

    <div class="mt-8 flex justify-center">
      <Button id="search-more" variant="outline" size="sm" icon="arrow-right" hidden>{t.next}</Button>
    </div>

    <noscript>
      <Panel variant="soft" padding="md" class="mt-6 text-[13px] text-muted">
        <p>{locale === 'zh' ? '搜索需要启用 JavaScript。你也可以通过归档或标签浏览内容。' : 'Search requires JavaScript. Browse the archive or tags instead.'}</p>
        <a class="mt-2 inline-block text-accent underline underline-offset-4" href={`/${locale}/archive/`}>{t.archive}</a>
      </Panel>
    </noscript>
  </section>

  {/* 搜索结果使用预渲染模板，脚本只负责填充链接与摘要。 */}
  <template id="search-result-template">
    <Panel as="article" padding="md" lift class="search-result group">
      <h2 class="font-serif text-[21px] leading-snug font-normal">
        <a data-result-link class="transition-colors duration-200 ease-soft hover:text-accent" href="#"></a>
      </h2>
      <p data-result-excerpt class="mt-3 text-[14px] leading-[1.9] text-muted"></p>
    </Panel>
  </template>
</Base>

<script>import '../../scripts/search';</script>
